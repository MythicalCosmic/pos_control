# Copy this file to .env for deployment. .env itself is gitignored.

# Set False (and provide a real SECRET_KEY) for any non-local environment.
DEBUG=True

# Required when DEBUG=False. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

# Comma-separated. Required when DEBUG=False (defaults to localhost,127.0.0.1).
# ALLOWED_HOSTS=control.example.com

# Public origin(s) of the admin dashboard, comma-separated. Required for the
# admin login form to pass CSRF when served over HTTPS behind a proxy.
# CSRF_TRUSTED_ORIGINS=https://control.example.com

# Browser origins allowed to call the bearer-token vendor API. Same-origin
# frontends need no entry. Never enable allow-all in production.
# CORS_ALLOWED_ORIGINS=https://dashboard.example.com

# --- Database ---
# Leave DB_ENGINE blank to use SQLite at db.sqlite3 (fine for a tiny install).
# For Postgres (recommended in production / docker-compose):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=pos_control_center
# DB_USER=pos_control_center
# DB_PASSWORD=
# DB_HOST=db
# DB_PORT=5432

# --- Reverse proxy / TLS ---
# Enable only when behind a TLS-terminating reverse proxy.
# TRUST_FORWARDED_PROTO=True
# Set only when the reverse proxy replaces X-Forwarded-For.
# TRUST_FORWARDED_FOR=True
# SECURE_SSL_REDIRECT=True

# --- gunicorn ---
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120

# --- Logging ---
# LOG_LEVEL=INFO

# --- Vendor API ---
# Access/refresh lifetimes, login throttling, pagination, and health policy.
# VENDOR_ACCESS_TOKEN_SECONDS=900
# VENDOR_REFRESH_TOKEN_SECONDS=604800
# VENDOR_LOGIN_WINDOW_SECONDS=900
# VENDOR_LOGIN_MAX_ATTEMPTS=5
# VENDOR_API_PAGE_SIZE=50
# VENDOR_API_MAX_PAGE_SIZE=200
# HEARTBEAT_ONLINE_MINUTES=10
# HEARTBEAT_DELAYED_MINUTES=30
# DEPLOYMENT_VERSION=

# Bootstrap password used only when deploy.sh creates the Django superuser or
# rotates the historical insecure default. Generate a long random value.
# DJANGO_ADMIN_PASSWORD=

# --- Vendor Ed25519 signing keypair (perpetual-unlock escape hatch) ---
# Generate once with: python manage.py generate_vendor_keypair
# The PUBLIC key is embedded in every alpha_pos build (LICENSE_VENDOR_PUBLIC_KEY
# there). The PRIVATE key belongs in an offline vault and should be loaded into
# the environment ONLY for the brief moment you run `generate_unlock`, then
# removed. Do NOT leave it set on the running control center.
# LICENSE_VENDOR_PUBLIC_KEY=
# LICENSE_VENDOR_PRIVATE_KEY=

# --- Payment providers (top-ups credit a tenant's prepaid balance) ---
# All credits flow in via the payment provider webhooks — the control
# center has no manual top-up form. Set the credentials before going live.
# Click.uz merchant (callbacks: /api/billing/click/prepare, /complete):
# CLICK_SERVICE_ID=
# CLICK_MERCHANT_ID=
# CLICK_SECRET_KEY=
# Payme.uz / Paycom (JSON-RPC endpoint: /api/billing/payme):
# PAYME_MERCHANT_KEY=

# --- Email (warning + lockout notifications) ---
# Sent by `python manage.py bill_subscriptions` (run daily from cron).
# Leave EMAIL_HOST blank to print emails to stdout (console backend) — useful
# in development. Set it to your SMTP server in production.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=POS Control Center <noreply@control.example.com>
